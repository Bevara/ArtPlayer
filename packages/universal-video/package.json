{
  "name": "universal-video",
  "version": "1.0.0",
  "description": "Bevara universal video plugin for ArtPlayer",
  "author": "Jerome Gorin <gorinje@gmail.com>",
  "license": "MIT",
  "homepage": "https://www.bevara.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Bevara/ArtPlayer"
  },
  "bugs": {
    "url": "https://github.com/Bevara/ArtPlayer/issues"
  },
  "keywords": [
    "html5",
    "video",
    "player"
  ],
  "exports": {
    ".": {
      "types": "./types/universal-video.d.ts",
      "import": "./dist/universal-video.mjs",
      "require": "./dist/universal-video.js"
    },
    "./legacy": {
      "types": "./types/universal-video.d.ts",
      "import": "./dist/universal-video.legacy.js",
      "require": "./dist/universal-video.legacy.js"
    }
  },
  "main": "./dist/universal-video.js",
  "module": "./dist/universal-video.mjs",
  "types": "./types/universal-video.d.ts",
  "legacy": "./dist/universal-video.legacy.js",
  "browserslist": "last 1 Chrome version"
}

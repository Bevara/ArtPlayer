{
  "name": "universal-canvas",
  "version": "1.0.0",
  "description": "Bevara universal canvas proxy for ArtPlayer",
  "author": "Jerome Gorin <gorinje@gmail.com>",
  "license": "MIT",
  "homepage": "https://www.bevara.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Bevara/ArtPlayer"
  },
  "bugs": {
    "url": "https://github.com/Bevara/ArtPlayer/issues"
  },
  "keywords": [
    "html5",
    "canvas",
    "player"
  ],
  "exports": {
    ".": {
      "types": "./types/universal-canvas.d.ts",
      "import": "./dist/universal-canvas.mjs",
      "require": "./dist/universal-canvas.js"
    },
    "./legacy": {
      "types": "./types/universal-canvas.d.ts",
      "import": "./dist/universal-canvas.legacy.js",
      "require": "./dist/universal-canvas.legacy.js"
    }
  },
  "main": "./dist/universal-canvas.js",
  "module": "./dist/universal-canvas.mjs",
  "types": "./types/universal-canvas.d.ts",
  "legacy": "./dist/universal-canvas.legacy.js",
  "browserslist": "last 1 Chrome version"
}
